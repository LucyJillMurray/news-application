# Copy this file to ".env" (next to manage.py) and fill in your own values.
# The .env file is git-ignored, so your real credentials are never committed.

# --- Database (local venv setup) ---
DB_NAME=news_db
DB_USER=news_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# --- Extra settings when running with Docker (docker-compose) ---
# When running in Docker, set DB_HOST to "db" (the compose service name)
# instead of localhost, and provide a root password for MariaDB to init with:
# DB_HOST=db
# DB_ROOT_PASSWORD=your_root_password

# Hosts/domains the app may serve. localhost/127.0.0.1 are enough for local
# and Docker-on-your-machine; add another host if serving remotely.
ALLOWED_HOSTS=localhost,127.0.0.1
